[node name="LblSteps" type="Label" parent="CanvasLayer/HelpPopup/Center/Card/VBox"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
theme_type_variation = &"PopupText"
text = "1.  Toca un alimento de los que están alrededor del plato.
2.  Sin soltarlo, arrástralo hasta el color de su grupo.
3.  Si aciertas, el panel de la derecha te cuenta para qué sirve ese grupo.
4.  Si te equivocas, el alimento vuelve a su lugar y recibes una pista.
5.  Ubica los 12 alimentos antes de que se acabe el tiempo.

Mientras esta ventana está abierta, el tiempo se detiene."
autowrap_mode = 3

